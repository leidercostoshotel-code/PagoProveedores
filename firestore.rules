rules_version = '2';

// Portal de Proveedores. Roles en usuarios/{uid}.rol (ver public/js/roles.js):
//   admin · contabilidad · consulta  → personal del hotel
//   proveedor                         → solo sus pagos (los de su RUC)
// Mismo esquema que la suite A-B-Swiss: perfil en "usuarios" + activo().
service cloud.firestore {
  match /databases/{database}/documents {

    function tienePerfil() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    // Autenticado + tiene perfil + no está desactivado.
    function activo() {
      return tienePerfil() && perfil().activo == true;
    }
    function rol() { return perfil().rol; }
    function esAdmin() { return activo() && rol() == 'admin'; }
    function esInterno() { return activo() && rol() in ['admin', 'contabilidad', 'consulta']; }
    function gestiona() { return activo() && rol() in ['admin', 'contabilidad']; }
    function esProveedorDe(ruc) {
      return activo() && rol() == 'proveedor' && perfil().ruc == ruc;
    }
    function propio(uid) { return request.auth != null && request.auth.uid == uid; }
    function cambios() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Perfiles de acceso.
    match /usuarios/{uid} {
      allow read: if propio(uid) || esInterno();
      // Admin crea a cualquiera; Contabilidad solo cuentas de proveedor.
      allow create: if esAdmin()
        || (gestiona() && request.resource.data.rol == 'proveedor');
      allow update: if (esAdmin() && !(propio(uid) && cambios().hasAny(['rol', 'activo'])))
        || (gestiona() && resource.data.rol == 'proveedor' && request.resource.data.rol == 'proveedor'
            && request.resource.data.ruc == resource.data.ruc)
        // Cada quien solo puede marcar que ya cambió su clave y su último ingreso
        // (con la hora del servidor: nada de textos inventados desde F12).
        || (propio(uid)
            && cambios().hasOnly(['debeCambiarClave', 'claveCambiadaEn', 'ultimoIngreso'])
            && (!cambios().hasAny(['debeCambiarClave']) || request.resource.data.debeCambiarClave == false)
            && (!cambios().hasAny(['claveCambiadaEn']) || request.resource.data.claveCambiadaEn == request.time)
            && (!cambios().hasAny(['ultimoIngreso']) || request.resource.data.ultimoIngreso == request.time));
      allow delete: if esAdmin() && !propio(uid);
    }

    // Pagos (ID = RUC_FACTURA_AAAAMMDD). El proveedor solo ve los de su RUC.
    match /pagos/{id} {
      allow read: if esInterno() || esProveedorDe(resource.data.ruc);
      allow write: if gestiona();
    }

    // Historial de lotes cargados.
    match /lotes/{id} {
      allow read: if esInterno();
      allow write: if gestiona();
    }

    // Comprobantes electrónicos (ID = RUC_TIPO_SERIE-NÚMERO). El proveedor sube y ve solo los de su RUC;
    // no puede tocar los que registró el hotel (Contabilidad o el Excel de Gosocket).
    function comprobanteOk(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['ruc', 'razonSocial', 'tipo', 'tipoNombre', 'serie', 'numero', 'correlativo', 'comprobante',
          'facturaPago', 'fechaEmision', 'fechaVencimiento', 'fechaRecepcion', 'moneda', 'tipoCambio', 'neto', 'exento',
          'impuestos', 'total', 'detraccion', 'rucReceptor', 'receptor', 'refTipo', 'refValor', 'estadoSunat',
          'motivoRechazo', 'gosocketId', 'items', 'origen', 'archivo', 'hash', 'tieneXml', 'tienePdf',
          'subidoPorUid', 'subidoEn'])
        && d.ruc is string && d.ruc.matches('[0-9]{11}')
        && d.tipo in ['01', '03', '07', '08'] && d.serie is string && d.numero is int
        && id == d.ruc + '_' + d.tipo + '_' + d.serie + '-' + string(d.numero)
        && d.fechaEmision is string && d.fechaEmision.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.total is number && d.origen in ['proveedor', 'hotel', 'gosocket']
        && d.items is list && d.items.size() <= 300;
    }
    function subidoAhora() {
      return request.resource.data.subidoPorUid == request.auth.uid && request.resource.data.subidoEn == request.time;
    }
    match /comprobantes/{id} {
      // Leer uno por ID (para saber si ya existe) solo si el ID empieza con su RUC.
      allow get: if esInterno() || esProveedorDe(id.split('_')[0]);
      allow list: if esInterno() || esProveedorDe(resource.data.ruc);
      allow create: if comprobanteOk(id) && subidoAhora()
        && ((gestiona() && request.resource.data.origen in ['hotel', 'gosocket'])
          || (esProveedorDe(request.resource.data.ruc) && request.resource.data.origen == 'proveedor'));
      allow update: if comprobanteOk(id)
        && (gestiona()
          || (esProveedorDe(resource.data.ruc) && resource.data.origen == 'proveedor'
              && request.resource.data.origen == 'proveedor' && subidoAhora()));
      allow delete: if gestiona();
    }

    // XML original y PDF de cada comprobante (mismo ID). Nunca se listan: se leen de a uno al descargar.
    // Quien puede escribir el comprobante escribe sus archivos (getAfter: el lote los guarda juntos).
    match /comprobantes_archivos/{id} {
      allow get: if esInterno() || esProveedorDe(id.split('_')[0]);
      allow list: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['xml', 'pdf', 'subidoPorUid', 'subidoEn'])
        && request.resource.data.xml is string && request.resource.data.xml.size() <= 1000000
        && (!('pdf' in request.resource.data) || request.resource.data.pdf is string)
        && subidoAhora()
        && existsAfter(/databases/$(database)/documents/comprobantes/$(id))
        && (gestiona()
          || (esProveedorDe(id.split('_')[0])
              && getAfter(/databases/$(database)/documents/comprobantes/$(id)).data.origen == 'proveedor'));
      allow delete: if gestiona();
    }

    // Bloqueo por intentos fallidos: solo lo tocan las Cloud Functions (Admin SDK).
    match /intentos_login/{email} {
      allow read, write: if false;
    }
  }
}
