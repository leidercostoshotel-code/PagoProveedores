{
  "name": "portal-proveedores",
  "version": "2.0.0",
  "private": true,
  "description": "Portal de consulta de pagos para proveedores (Firebase Hosting + Firestore + Functions)",
  "scripts": {
    "servir": "npx --yes serve public -l 5000",
    "deploy": "firebase deploy --only hosting,firestore",
    "deploy:functions": "firebase deploy --only functions",
    "probar:reglas": "firebase emulators:exec --only firestore --project demo-portal \"node pruebas/reglas.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^13.35.1"
  }
}
